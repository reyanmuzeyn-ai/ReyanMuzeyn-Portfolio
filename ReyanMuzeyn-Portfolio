  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --accent: #f59e0b;
      --accent-hover: #d97706;
      --accent-glow: rgba(245, 158, 11, 0.28);
      --accent-soft: rgba(245, 158, 11, 0.1);
      --accent-border: rgba(245, 158, 11, 0.32);

      --coffee-soft: rgba(180, 83, 9, 0.12);
      --coffee-border: rgba(180, 83, 9, 0.35);

      --bg: #0d0907;
      --bg-surface: #18110d;
      --card-bg: rgba(255, 248, 240, 0.04);
      --border: rgba(245, 235, 220, 0.1);
      --border-light: rgba(245, 235, 220, 0.18);

      --text: #faf6f0;
      --text-muted: #b8aba0;
      --text-subtle: #7d7065;

      --nav-bg: #0d0907;
      --shadow-sm: 0 10px 25px rgba(0, 0, 0, 0.6);
      --shadow-lg: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
      --font-mono: 'JetBrains Mono', monospace;
      --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    body.light {
      --accent: #b45309;
      --accent-hover: #92400e;
      --accent-glow: rgba(180, 83, 9, 0.18);
      --accent-soft: rgba(180, 83, 9, 0.08);
      --accent-border: rgba(180, 83, 9, 0.25);

      --coffee-soft: rgba(120, 53, 15, 0.08);
      --coffee-border: rgba(120, 53, 15, 0.25);

      --bg: #fdfbf7;
      --bg-surface: #ffffff;
      --card-bg: #ffffff;
      --border: #ebdccf;
      --border-light: #d8c2b0;

      --text: #261911;
      --text-muted: #5e493b;
      --text-subtle: #8a7363;

      --nav-bg: #fdfbf7;
      --shadow-sm: 0 10px 25px rgba(38, 25, 17, 0.05);
      --shadow-lg: 0 20px 40px rgba(38, 25, 17, 0.08);
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
      transition: background-color 0.35s ease, color 0.35s ease;
    }

    ::selection { background: var(--accent); color: #ffffff; }

    .container {
      width: min(1200px, 92%);
      margin-inline: auto;
    }

    #particles {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -3;
      pointer-events: none;
    }

    .background-glow {
      position: fixed;
      width: 520px;
      height: 520px;
      border-radius: 50%;
      background: var(--accent-glow);
      filter: blur(140px);
      z-index: -2;
      pointer-events: none;
      animation: ambientGlow 15s infinite alternate ease-in-out;
    }

    .glow-one { top: -180px; left: -120px; }
    .glow-two { right: -180px; bottom: -180px; animation-delay: 5s; }

    @keyframes ambientGlow {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(70px, 40px) scale(1.15); }
    }

    #progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), #fbbf24);
      z-index: 9999;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 70px;
      display: flex;
      align-items: center;
      z-index: 1000;
      background: var(--nav-bg);
      border-bottom: 1px solid var(--border);
      transition: var(--transition);
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: min(1200px, 92%);
      margin-inline: auto;
    }

    .logo {
      text-decoration: none;
      color: var(--text);
      font-size: 1.5rem;
      font-weight: 900;
      letter-spacing: -1.2px;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .logo span { color: var(--accent); }

    /* ግልጽና ጎልቶ የሚታይ የሰዓት ባጅ (Prominent Time Badge) */
    .time-badge-hero {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 50px;
      background: var(--card-bg);
      border: 1px solid var(--accent-border);
      font-size: 0.82rem;
      font-family: var(--font-mono);
      color: var(--text);
      margin-bottom: 1rem;
      box-shadow: 0 4px 15px var(--accent-soft);
    }

    .time-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      animation: pulse 1.8s infinite;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.6rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 600;
      transition: var(--transition);
      position: relative;
    }

    .nav-links a:hover { color: var(--text); }

    .nav-actions {
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 700;
      transition: var(--transition);
    }

    .icon-btn:hover {
      background: var(--accent);
      color: #ffffff;
      border-color: var(--accent);
    }

    .menu-btn { display: none; }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 110px 0 60px;
    }

    .hero-container {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 3rem;
      align-items: center;
    }

    .badge-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 1.2rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent);
      background: var(--accent-soft);
      border: 1px solid var(--accent-border);
      padding: 5px 14px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-family: var(--font-mono);
    }

    .badge-available {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #10b981;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 5px 12px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      font-family: var(--font-mono);
    }

    .green-dot {
      width: 7px;
      height: 7px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 10px #10b981;
      animation: pulseGreen 1.6s infinite;
    }

    @keyframes pulseGreen {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.5; }
    }

    .badge-dot {
      width: 7px;
      height: 7px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent);
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.4; }
    }

    .hero h1 {
      font-size: clamp(2.2rem, 4.5vw, 3.8rem);
      line-height: 1.15;
      letter-spacing: -1.5px;
      font-weight: 900;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .hero h1 .accent { color: var(--accent); }

    .hero-subtitle {
      font-size: clamp(1rem, 2vw, 1.35rem);
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 1.2rem;
      min-height: 2rem;
      font-family: var(--font-mono);
    }

    .hero-description {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 580px;
      margin-bottom: 1.8rem;
    }

    .hero-buttons {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 1.6rem;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
      transition: var(--transition);
      cursor: pointer;
      border: 1px solid transparent;
      font-size: 0.9rem;
    }

    .btn-primary {
      color: #ffffff;
      background: var(--accent);
      box-shadow: 0 8px 20px var(--accent-glow);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
    }

    .btn-outline {
      color: var(--text);
      border-color: var(--border-light);
      background: var(--card-bg);
    }

    .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    .btn-resume {
      color: var(--accent);
      border-color: var(--accent-border);
      background: var(--accent-soft);
    }

    .btn-resume:hover {
      background: var(--accent);
      color: #ffffff;
      transform: translateY(-2px);
    }

    .hero-photo {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    .photo-frame {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      padding: 6px;
      background: linear-gradient(135deg, var(--accent), rgba(217, 119, 6, 0.2), var(--border));
      box-shadow: 0 0 35px var(--accent-glow);
      position: relative;
    }

    .avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: var(--bg-surface);
      overflow: hidden;
      cursor: pointer;
      position: relative;
      border: 3px solid var(--bg);
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-hint {
      margin-top: 0.8rem;
      color: var(--text-subtle);
      font-size: 0.78rem;
      font-family: var(--font-mono);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-block: 1px solid var(--border);
      background: var(--card-bg);
    }

    .stat {
      padding: 2.2rem 1rem;
      text-align: center;
      border-right: 1px solid var(--border);
    }

    .stat:last-child { border-right: none; }

    .stat-number {
      font-size: 2.2rem;
      color: var(--accent);
      font-weight: 900;
      margin-bottom: 0.2rem;
      font-family: var(--font-mono);
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 600;
    }

    section { padding: 85px 0; }
    .section-head { margin-bottom: 3rem; }

    .section-label {
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      font-family: var(--font-mono);
    }

    .section-head h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      letter-spacing: -1.2px;
      line-height: 1.15;
      margin-bottom: 0.6rem;
      color: var(--text);
    }

    .section-head p {
      color: var(--text-muted);
      max-width: 650px;
      font-size: 1rem;
    }

    .spotlight-card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 2rem;
      overflow: hidden;
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    .spotlight-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-border);
    }

    .card-content { position: relative; z-index: 1; }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.6rem;
    }

    .project-card {
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--card-bg);
      padding: 2.2rem;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .project-card:hover {
      border-color: var(--accent-border);
      transform: translateY(-4px);
      box-shadow: var(--shadow-sm);
    }

    .project-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .project-icon { font-size: 2.4rem; }

    .project-tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 50px;
      background: var(--coffee-soft);
      border: 1px solid var(--coffee-border);
      color: var(--accent);
    }

    .project-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.6rem;
      color: var(--text);
    }

    .project-card p {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 1.4rem;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: auto;
    }

    .tech-pill {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border);
      color: var(--text-muted);
    }

    body:not(.light) .tech-pill { background: rgba(255, 255, 255, 0.04); }

    .flagship-box {
      border-radius: 24px;
      background: linear-gradient(135deg, var(--coffee-soft), var(--card-bg));
      border: 1px solid var(--coffee-border);
      padding: 3rem;
      box-shadow: var(--shadow-lg);
    }

    .flagship-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.8rem;
      flex-wrap: wrap;
      gap: 1.2rem;
    }

    .flagship-title-wrap {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .flagship-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      background: linear-gradient(135deg, #f59e0b, #d97706, #78350f);
      display: grid;
      place-items: center;
      font-size: 1.6rem;
      color: #ffffff;
    }

    .flagship-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      margin-top: 1.8rem;
    }

    .flagship-feat-card {
      background: rgba(0, 0, 0, 0.18);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.4rem;
      transition: var(--transition);
    }

    body.light .flagship-feat-card { background: rgba(255, 255, 255, 0.85); }

    .flagship-feat-card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
    }

    .flagship-feat-card h4 {
      font-size: 1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .flagship-feat-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 2.5rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }

    .contact-item:last-child { border-bottom: none; }

    .contact-item-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
    }

    .contact-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--accent-soft);
      font-size: 1.2rem;
      border: 1px solid var(--accent-border);
      color: var(--accent);
    }

    .contact-item a {
      color: var(--text);
      text-decoration: none;
      font-weight: 700;
      transition: var(--transition);
    }

    .contact-item a:hover { color: var(--accent); }

    .copy-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: var(--transition);
    }

    .copy-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .copy-btn.copied {
      background: #10b981;
      border-color: #10b981;
      color: #ffffff;
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-group label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .form-input, .form-textarea {
      width: 100%;
      background: rgba(0, 0, 0, 0.04);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 0.85rem 1.1rem;
      color: var(--text);
      font-family: inherit;
      font-size: 0.92rem;
      outline: none;
      transition: var(--transition);
    }

    body:not(.light) .form-input, body:not(.light) .form-textarea {
      background: rgba(255, 248, 240, 0.03);
    }

    .form-input:focus, .form-textarea:focus {
      border-color: var(--accent);
    }

    .form-textarea { resize: vertical; min-height: 110px; }

    .quick-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 4px;
    }

    .chip-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 5px 11px;
      border-radius: 50px;
      font-size: 0.78rem;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: var(--transition);
    }

    .chip-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-soft);
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem 0;
      color: var(--text-muted);
      text-align: center;
      font-size: 0.88rem;
    }

    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #25d366;
      color: white;
      text-decoration: none;
      box-shadow: 0 8px 20px rgba(37, 211, 102, 0.35);
      z-index: 900;
      transition: var(--transition);
    }

    .whatsapp svg { width: 26px; height: 26px; fill: #ffffff; }

    #backTop {
      position: fixed;
      right: 20px;
      bottom: 80px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 900;
      font-size: 1.1rem;
      transition: var(--transition);
    }

    #backTop.show { display: flex; }

    #toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--accent);
      color: #ffffff;
      padding: 0.85rem 1.8rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 10px 30px var(--accent-glow);
      z-index: 3000;
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
